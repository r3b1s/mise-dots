# OmniRoute self-host defaults. Copied to ~/.config/omniroute/.env by setup.sh
# on first install; existing values are never overwritten. Mirrors the
# upstream .env.selfhost.example (loopback-only, unauthenticated by default).

DASHBOARD_PORT=20128
API_PORT=20129
LIVE_WS_PORT=20132

# 127.0.0.1 = loopback only (safe with REQUIRE_API_KEY=false).
APP_BIND_HOST=127.0.0.1

REQUIRE_API_KEY=false

# 2048 = safe default for coding agents (long POST /v1/responses bodies).
OMNIROUTE_MEMORY_MB=2048
